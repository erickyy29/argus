# NASA API key from https://api.nasa.gov (free). DEMO_KEY works but allows only a few requests per hour.
# The server falls back to DEMO_KEY automatically if a key is rejected.
NASA_API_KEY=DEMO_KEY

# Local port for the dashboard (http://localhost:8080)
PORT=8080

# Optional: Nominatim-compatible geocoder for place search (default: the public OSM service, light use only)
# NOMINATIM_URL=https://nominatim.example.org
