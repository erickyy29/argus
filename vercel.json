{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=api/:path*" },
    { "source": "/vendor/:path*", "destination": "/api/index?__route=vendor/:path*" }
  ],
  "functions": {
    "api/index.mjs": { "maxDuration": 300 }
  }
}
